# Android / Gradle artifacts (under Library when not ignored, or local exports)
**/*.apk
**/*.aab
**/*.keystore
!**/ProjectSettings/*.asset

# Local bug tracker (QA reports, logs, scratch — not versioned)
bugs/

# Repo-root placeholder (empty); real QA scripts live under bugs/tools/ (local) or Lexting_Unity bootstrap
/tools/

# Unity Package Manager cache (belongs under Library/; ignore if copied into repo by mistake)
**/PackageCache/

# Unity Pipeline local port file (sometimes outside Library during dev)
**/.unity-pipeline-port

# Secrets
.env
.env.*
*.pem
credentials.json
**/secrets.json
